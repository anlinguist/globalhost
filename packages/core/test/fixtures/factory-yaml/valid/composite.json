{
  "version": 1,
  "product": "composite",
  "owners": [
    {
      "login": "octo-owner",
      "id": 1001
    }
  ],
  "autonomy": "L1",
  "project": null,
  "git": {
    "defaultBranch": "main",
    "baseBranch": "main"
  },
  "environments": {
    "dev": {
      "gcpProject": "composite-dev",
      "region": "europe-west1"
    }
  },
  "parts": {
    "api": {
      "path": "apps/api",
      "profile": "fake-api",
      "config": {
        "entry": "src/server.ts"
      },
      "preview": {
        "enabled": true,
        "bindings": {}
      },
      "release": [],
      "dependsOn": []
    },
    "web": {
      "path": "apps/web",
      "profile": "fake-web",
      "config": {
        "port": 3000,
        "routes": [
          "/"
        ]
      },
      "preview": {
        "enabled": true,
        "bindings": {
          "API_URL": {
            "part": "api",
            "output": "url"
          }
        }
      },
      "release": [],
      "dependsOn": [
        "api"
      ]
    },
    "ext": {
      "path": "apps/extension",
      "profile": "fake-ext",
      "config": {},
      "preview": {
        "enabled": true,
        "bindings": {
          "API_URL": {
            "part": "api",
            "output": "docsUrl"
          }
        }
      },
      "release": [],
      "dependsOn": [
        "api"
      ]
    }
  },
  "limits": {
    "maxConcurrentBuilders": 1,
    "perRunUsd": 4,
    "perRunMinutes": 45,
    "dailyUsd": 20
  },
  "guardrails": {
    "loadBearing": [],
    "immutable": [
      ".github/**",
      "factory.yaml",
      "CODEOWNERS",
      "docs/CODEOWNERS"
    ]
  },
  "autoMerge": [],
  "notifications": {
    "blocking": "push",
    "previews": "digest",
    "routine": "digest"
  }
}
