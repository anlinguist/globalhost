{
  "name": "globalhost",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0+sha512.fce8a3dd29a4ed2ec566fb53efbb04d8c44a0f05bc6f24a73046910fb9c3ce7afa35a0980500668fa3573345bd644644fa98338fa168235c80f4aa17aa17fbef",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . && pnpm lint:actions",
    "lint:actions": "zizmor --offline .github templates/.github packages/action && actionlint && actionlint templates/.github/workflows/*.yml",
    "globalhost": "turbo run build --filter=@globalhost/cli --output-logs=errors-only && node packages/cli/dist/bin.js",
    "schema:update": "pnpm --filter @globalhost/core schema:update"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
